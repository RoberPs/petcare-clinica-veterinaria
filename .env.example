# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Conexión a PostgreSQL (docker compose levanta "db" en el puerto 5434).
DATABASE_URL=postgres://petcare:petcare@localhost:5434/petcare
# Base de datos de pruebas de integración y de extremo a extremo ("db-test", puerto 5433).
DATABASE_URL_TEST=postgres://petcare:petcare@localhost:5433/petcare_test

# Proveedor de correo: "fake" en local y en pruebas, "brevo" en producción.
EMAIL_PROVIDER=fake
# Clave de la API de Brevo (solo producción). Déjala vacía en local.
BREVO_API_KEY=
# Remitente verificado en Brevo (SPF y DKIM), con nombre visible.
EMAIL_FROM="PetCare <no-responder@example.com>"
# URL del proveedor de correo falso (servicio "email-fake").
FAKE_EMAIL_URL=http://localhost:8025

# Secreto para firmar el token de los formularios, la cookie de consentimiento, la pista del inicio de
# sesión (pc_login_hint) y los HMAC del límite de intentos (32 caracteres o más). Desde la feature 003
# firma también los enlaces de gestión de citas de la clínica y la confirmación de la reserva: si
# cambia, los enlaces de gestión de los correos ya enviados dejan de valer.
FORM_SECRET=
# Versión de la política de cookies. Si cambia, se vuelve a pedir el consentimiento.
CONSENT_VERSION=1

# Datos de la clínica que no se escriben en el repositorio (se usan en content/<clinica>.yaml).
# Buzón que recibe los mensajes del formulario. No se publica.
CLINIC_INBOX_EMAIL=
# Teléfono que controla el responsable de la demo, en E.164 (+34...) y como se muestra.
CLINIC_PHONE_E164=
CLINIC_PHONE_DISPLAY=
# Responsable real del tratamiento y correo para ejercer los derechos.
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=

# IP del proxy de confianza (Caddy). Vacío en local: no hay proxy delante.
TRUSTED_PROXY_IPS=
# URL pública de la web, sin barra final (metadatos, sitemap y enlaces de los correos).
# Feature 002: los enlaces de los correos de cuenta (confirmar el correo, restablecer la contraseña)
# se construyen con ella, y si empieza por https:// la cookie de sesión pc_session lleva Secure.
SITE_URL=http://localhost:3000

# Feature 005 — pasarela de pago.
# "fake" en local y en pruebas (pasarela simulada en /pago-simulado); "stripe" en la demo publicada.
PAYMENT_PROVIDER=fake
# Clave secreta de Stripe. SOLO claves de prueba (sk_test_… o rk_test_…): con otra la app no arranca.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook de Stripe (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Permite PAYMENT_PROVIDER=fake con NODE_ENV=production (solo en una demo sin claves).
PAYMENT_FAKE_ALLOWED=false

# Feature 006 — boletín.
# Clave de la huella anónima de las bajas (HMAC del correo). 32 bytes aleatorios en base64, por
# ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))".
# Solo hace falta si el boletín está activo (newsletter.enabled en el archivo de contenido).
NEWSLETTER_HASH_KEY=

# Feature 008 — fotos de producto subidas desde el panel.
# Directorio donde se guardan las variantes WebP. En local, ./var/uploads (ignorado por git); en
# producción, el volumen petcare-uploads montado en /app/var/uploads.
UPLOADS_DIR=./var/uploads
