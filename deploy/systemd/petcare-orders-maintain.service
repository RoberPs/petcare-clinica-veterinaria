# concilia pagos, caduca pedidos vencidos y reintenta reembolsos
[Unit]
Description=PetCare: concilia pagos, caduca pedidos vencidos y reintenta reembolsos
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/petcare
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml exec -T petcare-app node cli/orders-maintain.mjs
