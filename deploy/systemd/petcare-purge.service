# borra los mensajes de más de 12 meses y los registros del límite de más de 24 h
[Unit]
Description=PetCare: borra los mensajes de más de 12 meses y los registros del límite de más de 24 h
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/petcare
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.prod.yml exec -T petcare-app node cli/retention-purge.mjs
