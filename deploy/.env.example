# Entorno de producción (copiar como deploy/.env en el VPS, con permisos 600). Sin valores reales aquí.

# Base de datos (contenedor petcare-db, solo en la red interna)
POSTGRES_USER=petcare
POSTGRES_PASSWORD=
POSTGRES_DB=petcare

# Correo: Brevo con remitente verificado (SPF y DKIM) y clave dedicada a este proyecto
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM="PetCare <no-responder@example.com>"

# Firmas del formulario, de la cookie de consentimiento y de los enlaces de gestión de citas
# (32 caracteres o más; openssl rand -base64 48). Cambiarlo invalida los enlaces de gestión ya enviados.
FORM_SECRET=
CONSENT_VERSION=1

# Datos que no van en el repositorio (se resuelven en content/petcare.yaml al cargar el contenido)
CLINIC_INBOX_EMAIL=
CLINIC_PHONE_E164=
CLINIC_PHONE_DISPLAY=
LEGAL_OWNER_NAME=
LEGAL_CONTACT_EMAIL=

# Pago (feature 005): Stripe en modo de pruebas. Solo claves sk_test_/rk_test_; nunca sk_live_.
# Para una demo sin Stripe: PAYMENT_PROVIDER=fake y PAYMENT_FAKE_ALLOWED=true.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_FAKE_ALLOWED=false
# Boletín (feature 006): openssl rand -base64 32. No lo cambies una vez en marcha.
NEWSLETTER_HASH_KEY=
# Límites de los contenedores (opcional; valores por defecto)
# PETCARE_APP_MEM=768m
# PETCARE_APP_CPUS=1.0
# PETCARE_DB_MEM=512m
# PETCARE_DB_CPUS=1.0
# IP del contenedor de Caddy en la red chatbot_proxy (docker network inspect chatbot_proxy)
TRUSTED_PROXY_IPS=
# Dominio público (subdominio de un solo nivel)
PETCARE_DOMINIO=petcare.example.com
SITE_URL=https://petcare.example.com
