{
  "name": "petcare-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Web pública de una clínica veterinaria configurable por archivo de contenido (demo PetCare).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit && npm run check:design",
    "check:design": "tsx scripts/check-design.ts",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "content:load": "tsx scripts/content-load.ts",
    "email:dispatch": "tsx scripts/email-dispatch.ts",
    "email:fake": "tsx scripts/fake-email-provider.ts",
    "email:fake:list": "tsx scripts/fake-email-provider.ts --list",
    "retention:purge": "tsx scripts/retention-purge.ts",
    "orders": "tsx scripts/orders.ts",
    "orders:maintain": "tsx scripts/orders-maintain.ts",
    "admin": "tsx scripts/admin.ts",
    "demo:seed": "tsx scripts/demo-seed.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
